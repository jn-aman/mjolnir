{
  "name": "odin",
  "version": "0.1.0",
  "private": true,
  "description": "See your whole cluster in one window — a native desktop app for Kubernetes, cloud access, and containers",
  "author": {
    "name": "Aman Jain",
    "email": "jain.aman1497@gmail.com"
  },
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "tsc --build",
    "typecheck:clean": "tsc --build --clean",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "dev": "npm run dev --workspace @odin/server & npm run dev --workspace @odin/web",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
